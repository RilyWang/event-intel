# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）
# 三项齐全 LLM 才会启用；缺任一则自动回退规则抽取（主链路不受影响）。

# 智谱 GLM（推荐：与本机 ZCode 内置同源，注册即用）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-plus
LLM_API_KEY=

# 其它可选（把上面两行换成对应值即可）
# DeepSeek：  LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-chat
# 通义千问：  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# Kimi：      LLM_BASE_URL=https://api.moonshot.cn/v1        LLM_MODEL=moonshot-v1-8k

# 单次请求超时（毫秒），超时后自动回退规则
LLM_TIMEOUT_MS=20000

# temperature：默认不发送（不同厂商允许范围不同，如 kimi-k2.6 仅接受 1）
# 需要时显式指定，例如 LLM_TEMPERATURE=1
# LLM_TEMPERATURE=1

# 置 1 可强制禁用 LLM（离线复跑测试用；测试脚本已自动设置）
# LLM_DISABLED=1

# 后端端口（8787 / 8899 在本机被平台代理占用，请求会被吞掉，故默认用 5311）
PORT=5311

# ---- 当前实际启用（月之暗面 Kimi）----
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k2.6
# LLM_TEMPERATURE=1
# 模型可用性自查：GET {LLM_BASE_URL}/models
